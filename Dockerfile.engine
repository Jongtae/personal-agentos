FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml /app/
COPY src/personal_agent /app/src/personal_agent
RUN apt-get update \
    && apt-get install --no-install-recommends -y nodejs npm \
    && npm install --global @openai/codex@0.153.4 \
    && pip install --no-cache-dir . \
    && useradd --create-home --uid 10002 engine \
    && mkdir -p /engine-profile \
    && chown -R engine:engine /engine-profile \
    && rm -rf /var/lib/apt/lists/* /root/.npm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CODEX_HOME=/engine-profile

USER engine
CMD ["python", "-m", "personal_agent.isolated_engine_sidecar", "--host", "0.0.0.0", "--port", "8766", "--callback", "http://agentos:8787/internal/isolated-engine/mcp"]
