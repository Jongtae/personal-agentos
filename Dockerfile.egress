FROM python:3.12-slim

WORKDIR /app
COPY src/personal_agent/__init__.py /app/personal_agent/__init__.py
COPY src/personal_agent/limited_egress_proxy.py /app/personal_agent/limited_egress_proxy.py
RUN useradd --create-home --uid 10003 egress

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER egress
EXPOSE 3128
CMD ["python", "-m", "personal_agent.limited_egress_proxy"]
